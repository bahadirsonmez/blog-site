<!doctype html>
<html lang="en">
<head>
  {%- set ogImageUrl = site.url + (ogImage or "/assets/social-preview-2026-10.png") %}
  {%- set ogAlt = ogImageAlt if ogImage else "Bahadır Sönmez — Blog: iOS software engineer, notes on Apple development, the Apple ecosystem and AI" %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#160572">
  <title>{% if title %}{{ title }} | {{ site.blogName }}{% else %}{{ site.blogName }}{% endif %}</title>
  <meta name="description" content="{{ summary or description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ title or site.blogName }}">
  <meta property="og:description" content="{{ summary or description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.blogName }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:image" content="{{ ogImageUrl }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="{{ ogAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.blogName }}">
  <meta name="twitter:description" content="{{ summary or description or site.description }}">
  <meta name="twitter:image" content="{{ ogImageUrl }}">
  <meta name="twitter:image:alt" content="{{ ogAlt }}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.blogName }}" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..800&family=Inter:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="/assets/prism.css">
  <link rel="stylesheet" href="/assets/blog.css">
  {% if jsonLd %}<script type="application/ld+json">{{ jsonLd | jsonScript | safe }}</script>{% endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="wordmark" href="{{ site.mainUrl }}/" aria-label="Bahadır Sönmez, main site">Bahadır<span>Sönmez</span></a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href="/">Blog</a>
      <a href="{{ site.mainUrl }}/#apps">Apps</a>
      <a href="{{ site.mainUrl }}/#about">About</a>
    </nav>
  </header>
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>© Bahadır Sönmez · <a href="{{ site.mainUrl }}/">bahadirsonmez.com</a></p>
    <p><a href="{{ site.linkedin }}">LinkedIn</a> · <a href="{{ site.github }}">GitHub</a> · <a href="/feed.xml">RSS</a></p>
  </footer>
  <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "{{ site.beaconToken }}"}'></script><!-- End Cloudflare Web Analytics -->
</body>
</html>
